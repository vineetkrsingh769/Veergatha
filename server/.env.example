# Copy to .env and fill in. NEVER put real values in this file — it is committed.

# Server
PORT=5000
NODE_ENV=development

# Comma-separated origins allowed to call this API.
# Local dev + your Vercel domain once it exists.
CORS_ORIGINS=http://localhost:5173

# MongoDB Atlas — Database > Connect > Drivers.
# Put the database name in the path, before the "?", or you write to "test".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/veergatha?retryWrites=true&w=majority

# JWT signing secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Cloudinary (media upload, not yet wired) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
