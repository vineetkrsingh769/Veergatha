# Copy to .env.local for development. Never commit real values.
#
# Leave EMPTY in local dev — vite.config.js proxies /api to localhost:5000.
# In Vercel, set this to your Render service URL with no trailing slash:
#   VITE_API_URL=https://veergatha-api.onrender.com
VITE_API_URL=

# Only needed if you install @reactbits-pro components (see components.json).
# The free @reactbits-starter registry does not require this.
REACTBITS_LICENSE_KEY=
